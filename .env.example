# MongoDB connection (Atlas recommended — transactions require a replica set,
# which a bare standalone mongod does not support; Atlas gives you one by
# default even on the free tier).
MONGODB_URI=
MONGODB_DB_NAME=Atomic-DB

# Google Cloud OAuth client (console.cloud.google.com > APIs & Services > Credentials)
# Scope requested is drive.file only — the app can see/manage only files IT
# creates, not the user's whole Drive. Keep it that way; broader scopes
# trigger Google's restricted-scope verification/CASA assessment process.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://atomic-notes-server-gde2e.vercel.app/api/auth/callback

# Encrypts Google access/refresh tokens at rest (AES-256-GCM).
# Must decode to exactly 32 bytes. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Comma-separated list of origins allowed to call this API (your Flutter app's origin(s)).
ALLOWED_ORIGIN=https://atomic-notes-community.vercel.app

# Shared secret for the admin API (/api/admin/*), used only by Atomic
# Community's server-side Controller routes — never shipped to any client.
# Generate with: openssl rand -base64 32
ADMIN_API_KEY=

PORT=3000
